{
  "name": "@bse/database",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --config ../../eslint.config.mjs src",
    "db:create": "bun run ./scripts/create-db.ts",
    "db:reset": "bun run ./scripts/reset-db.ts && bun run db:push",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push && bun run ./scripts/seed-db.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  }
}
